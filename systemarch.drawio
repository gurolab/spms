        </mxCell>
        <mxCell id="ven-tcpdf" value="&lt;b&gt;TCPDF 6.7.4&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Pure-PHP PDF engine&lt;br/&gt;Barcode + font support&lt;br/&gt;Used via:&lt;br/&gt;   core/pdf/TcpdfHelper.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e1e1;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
