        </mxCell>
        <mxCell id="ven-phpm" value="&lt;b&gt;PHPMailer&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;SMTP transport library&lt;br/&gt;HTML body + attachments&lt;br/&gt;Used via:&lt;br/&gt;   core/mailer.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e1e1;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="2160" y="385" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Assets -->
        <mxCell id="assets-label" value="STATIC ASSETS (assets/)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1850" y="535" width="400" height="15" as="geometry" />
        </mxCell>
        <mxCell id="assets-box" value="&lt;b&gt;assets/css/&lt;/b&gt;&lt;br/&gt;Bootstrap 5  ·  ApexCharts  ·  jQuery UI  ·  Slick  ·  FullCalendar  ·  Plyr  ·  Quill editor  ·  file-upload  ·  main.css (compiled from SASS)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;assets/js/&lt;/b&gt;&lt;br/&gt;main.js  ·  alert.js  ·  calendar.js  ·  counterup.js  ·  file-upload.js  ·  vendor libraries&lt;br/&gt;&lt;br/&gt;&lt;b&gt;assets/sass/&lt;/b&gt;  — style source files&lt;br/&gt;&lt;b&gt;assets/images/&lt;/b&gt;  — UI graphics, logos, icons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
