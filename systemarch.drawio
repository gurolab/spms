        <!-- Vendor -->
        <mxCell id="vendor-label" value="VENDOR / THIRD-PARTY (vendor/)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
