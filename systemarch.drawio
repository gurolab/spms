<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="SPMS Architecture" id="spms-arch">
    <mxGraphModel dx="2500" dy="1850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="SPMS — Supply &amp;amp; Property Management System  |  System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0e2238;" vertex="1" parent="1">
          <mxGeometry x="40" y="5" width="2420" height="30" as="geometry" />
        </mxCell>

        <!-- ============ LAYER 1: BROWSER ============ -->
        <mxCell id="L1-label" value="LAYER 1 — Client / Presentation" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="400" height="15" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser (Client)&lt;/b&gt;&lt;br/&gt;HTML5  ·  Bootstrap 5  ·  jQuery 3.7.1  ·  jQuery UI  ·  ApexCharts  ·  FullCalendar  ·  Plyr  ·  Quill  ·  Slick Carousel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1780" height="65" as="geometry" />
        </mxCell>

        <!-- ============ LAYER 2: ENTRY & AUTH ============ -->
        <mxCell id="L2-label" value="LAYER 2 — Public Entry &amp;amp; Auth Boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="500" height="15" as="geometry" />
        </mxCell>
        <mxCell id="entry-points" value="&lt;b&gt;Public Entry Points (root)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;index.php  (role-based dashboard router)&lt;br/&gt;login.php  ·  register.php  ·  forgotpwd.php  ·  resetpwd.php  ·  logout.php&lt;br/&gt;profile.php  ·  profile-actions.php  ·  account.php  ·  unauthorized.php" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1180" height="130" as="geometry" />
        </mxCell>
        <mxCell id="auth-mw" value="&lt;b&gt;Auth / Security Middleware&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• core/auth_guard.php&lt;br/&gt;   requireAuth() · requireRole([…])&lt;br/&gt;• core/csrf.php&lt;br/&gt;   32-byte token  ·  constant-time check&lt;br/&gt;• Rate-limit: 10 login attempts / 15 min / IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1240" y="160" width="580" height="130" as="geometry" />
        </mxCell>

        <!-- ============ LAYER 3: ROLE MODULES ============ -->
        <mxCell id="L3-label" value="LAYER 3 — Role-Based Modules (six role directories, each with its own dashboard &amp;amp; workflow pages)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="900" height="15" as="geometry" />
        </mxCell>

        <mxCell id="admin-col" value="&lt;b&gt;administrator/&lt;/b&gt;  (Role 1)&lt;br/&gt;&lt;br/&gt;dashboard&lt;br/&gt;users  ·  roles  ·  departments&lt;br/&gt;items  ·  suppliers&lt;br/&gt;ris&lt;br/&gt;supply-receive  ·  supply-issuance&lt;br/&gt;supply-ledger&lt;br/&gt;ics  ·  par&lt;br/&gt;property-cards  ·  transfers&lt;br/&gt;physical-inventory  ·  physical-ppe&lt;br/&gt;audit-logs&lt;br/&gt;system-settings&lt;br/&gt;reorder-reports&lt;br/&gt;&lt;i&gt;print/  — 8 PDF generators&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="290" height="385" as="geometry" />
        </mxCell>

        <mxCell id="supply-col" value="&lt;b&gt;supplyofficer/&lt;/b&gt;  (Role 2)&lt;br/&gt;&lt;br/&gt;dashboard&lt;br/&gt;ris  (requisition management)&lt;br/&gt;receive  (deliveries from suppliers)&lt;br/&gt;issuance  (supply release)&lt;br/&gt;item-detail&lt;br/&gt;inventory-reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="338" y="325" width="290" height="385" as="geometry" />
        </mxCell>

        <mxCell id="inv-col" value="&lt;b&gt;inventoryofficer/&lt;/b&gt;  (Role 3)&lt;br/&gt;&lt;br/&gt;dashboard&lt;br/&gt;stockcard&lt;br/&gt;stockcard-detail&lt;br/&gt;slc  (Stock Ledger Card)&lt;br/&gt;reconciliation&lt;br/&gt;stock-inventory-actions&lt;br/&gt;reorder-point tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="636" y="325" width="290" height="385" as="geometry" />
        </mxCell>

        <mxCell id="prop-col" value="&lt;b&gt;propertycustodian/&lt;/b&gt;  (Role 4)&lt;br/&gt;&lt;br/&gt;dashboard&lt;br/&gt;ics  (Inventory Custodian Slip)&lt;br/&gt;par  (Property Acknowledgment Receipt)&lt;br/&gt;property-cards&lt;br/&gt;transfers  (custodian handover)&lt;br/&gt;transaction-audit&lt;br/&gt;dashboard-analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="934" y="325" width="290" height="385" as="geometry" />
        </mxCell>

        <mxCell id="aud-col" value="&lt;b&gt;auditor/&lt;/b&gt;  (Role 5)&lt;br/&gt;&lt;br/&gt;dashboard&lt;br/&gt;   compliance monitoring&lt;br/&gt;   RPCI  ·  RPCPPE  ·  IIRUP reports&lt;br/&gt;sidebar  (partial)&lt;br/&gt;&lt;br/&gt;Read-only over physical&lt;br/&gt;inventory &amp;amp; PPE records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1232" y="325" width="290" height="385" as="geometry" />
        </mxCell>

        <mxCell id="emp-col" value="&lt;b&gt;employee/&lt;/b&gt;  (Role 6)&lt;br/&gt;&lt;br/&gt;dashboard&lt;br/&gt;requisitions  (submit RIS)&lt;br/&gt;request-management&lt;br/&gt;property-acknowledgment&lt;br/&gt;   (sign for issued items)&lt;br/&gt;sidebar  (partial)&lt;br/&gt;&lt;br/&gt;Self-service portal,&lt;br/&gt;dept-scoped data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1530" y="325" width="290" height="385" as="geometry" />
        </mxCell>

        <!-- ============ LAYER 4: API GATEWAY ============ -->
        <mxCell id="L4-label" value="LAYER 4 — API Gateway (AJAX action router)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="500" height="15" as="geometry" />
        </mxCell>
        <mxCell id="api-gateway" value="&lt;b&gt;api/admin.php&lt;/b&gt; — Action-based AJAX router (?action=…)&lt;br/&gt;getAllDepartments · getAllRoles · getAllUsers · getUserById · getSupplierById · getSupplyReceiveHeaderById · addReceiveItem&lt;br/&gt;getAllRIS · getRISById · getICSById · getPARById · getItemById  ·  ~20+ role-gated actions (isLoggedIn → role matrix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;verticalAlign=middle;align=center;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1780" height="75" as="geometry" />
        </mxCell>

        <!-- ============ LAYER 5: CORE FRAMEWORK ============ -->
        <mxCell id="L5-label" value="LAYER 5 — Core Framework (core/)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="500" height="15" as="geometry" />
        </mxCell>

        <mxCell id="core-config" value="&lt;b&gt;config.php&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;DB credentials (PDO)&lt;br/&gt;BASE_URL  ·  ROLE_* constants&lt;br/&gt;Session hardening:&lt;br/&gt;   HttpOnly  ·  Secure (HTTPS)&lt;br/&gt;   SameSite  ·  strict_mode&lt;br/&gt;Email whitelist  ·  SMTP config" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="350" height="145" as="geometry" />
        </mxCell>

        <mxCell id="core-helper" value="&lt;b&gt;helper.php&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;requireAuth()  ·  requireRole()&lt;br/&gt;writeAuditLog($action, $details)&lt;br/&gt;   (captures IP, UA, timestamp)&lt;br/&gt;setFlash() / getFlash()&lt;br/&gt;Input validation helpers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="398" y="860" width="350" height="145" as="geometry" />
        </mxCell>

        <mxCell id="core-model" value="&lt;b&gt;Model.php  +  BaseModel.php&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;PDO connection wrapper (MySQL)&lt;br/&gt;Common CRUD:&lt;br/&gt;   getAll()  ·  getById()  ·  deleteById()&lt;br/&gt;PDO::ERRMODE_EXCEPTION&lt;br/&gt;PDO::FETCH_ASSOC&lt;br/&gt;Inherited by every repo/ model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="756" y="860" width="350" height="145" as="geometry" />
        </mxCell>

        <mxCell id="core-mailer" value="&lt;b&gt;mailer.php&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;PHPMailer SMTP wrapper&lt;br/&gt;sendPasswordResetEmail()&lt;br/&gt;Rate-limit: 3 resets / hour&lt;br/&gt;   (session-based sliding window)&lt;br/&gt;30-min reset link expiry&lt;br/&gt;HTML email templates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1114" y="860" width="350" height="145" as="geometry" />
        </mxCell>

        <mxCell id="core-pdf" value="&lt;b&gt;pdf/TcpdfHelper.php&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;spms_pdf_init()&lt;br/&gt;spms_pdf_render()&lt;br/&gt;spms_pdf_output()&lt;br/&gt;Generates official forms:&lt;br/&gt;   RPCI  ·  RPCPPE  ·  IIRUP&lt;br/&gt;   ICS  ·  PAR  ·  RIS  ·  RSMI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1472" y="860" width="348" height="145" as="geometry" />
        </mxCell>

        <!-- ============ LAYER 6: DATA MODELS ============ -->
        <mxCell id="L6-label" value="LAYER 6 — Data Models (repo/) — 18 model classes, BaseModel-derived, PDO prepared statements, dept-scoped queries" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="1300" height="15" as="geometry" />
        </mxCell>

        <!-- Row 1 of model domains -->
        <mxCell id="mod-auth" value="&lt;b&gt;Auth / User Domain&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• User.model.php&lt;br/&gt;   accounts, status, dept link&lt;br/&gt;• Account.model.php&lt;br/&gt;   login · register · token mgmt&lt;br/&gt;• Role.model.php  (6 roles)&lt;br/&gt;• Department.model.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="438" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mod-supply" value="&lt;b&gt;Supply Domain&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Supply_Receive.model.php&lt;br/&gt;   PR/PO/DR/SI/IAR refs, batch, expiry&lt;br/&gt;• Supply_Issuance.model.php&lt;br/&gt;• Supplier.model.php&lt;br/&gt;• SupplyLedger.model.php&lt;br/&gt;   Supply_Ledger_Card + Entry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="487" y="1040" width="438" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mod-req" value="&lt;b&gt;Requisition Domain&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• RIS.model.php&lt;br/&gt;   RIS  (requisition_slips header)&lt;br/&gt;   RIS_Items  (qty_requested/issued)&lt;br/&gt;Doc #:  RIS-YYYY-XXXX&lt;br/&gt;Status workflow:&lt;br/&gt;   pending → approved → issued" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="934" y="1040" width="438" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mod-prop" value="&lt;b&gt;Property / Asset Domain&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• ICS.model.php   (ICS-YYYY-XXXX)&lt;br/&gt;• PAR.model.php   (PAR-YYYY-XXXX)&lt;br/&gt;• PropertyCard.model.php (PC-…)&lt;br/&gt;   + PropertyCardTransaction&lt;br/&gt;• PropertyTransfer.model.php&lt;br/&gt;• UnserviceableProperty.model.php" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1381" y="1040" width="439" height="140" as="geometry" />
        </mxCell>

        <!-- Row 2 of model domains -->
        <mxCell id="mod-inv" value="&lt;b&gt;Inventory / Stock Domain&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Item.model.php  (master item data, consumable flag, stock_onhand)&lt;br/&gt;• StockCard.model.php  (SC-XXXXX, reorder point, max level)&lt;br/&gt;• StockInventory.model.php  (current balance per item)&lt;br/&gt;• StockTransaction.model.php  (add/reduce movement history)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1195" width="588" height="135" as="geometry" />
        </mxCell>

        <mxCell id="mod-audit" value="&lt;b&gt;Audit / Physical Domain&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• AuditLog.model.php  ★ cross-cutting&lt;br/&gt;   activity_logs · audits · audit_details · role-scoped views · field-level history (old/new)&lt;br/&gt;• PhysicalInventory.model.php  (consumables count)&lt;br/&gt;• PhysicalPpe.model.php  (PPE physical count)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="636" y="1195" width="588" height="135" as="geometry" />
        </mxCell>

        <mxCell id="mod-sys" value="&lt;b&gt;System Configuration&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• SystemSettings.model.php&lt;br/&gt;   Application-wide settings&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Primary key pattern: incremental `id`, document #s auto-generated PREFIX-YYYY-SEQ&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1232" y="1195" width="588" height="135" as="geometry" />
        </mxCell>

        <!-- ============ LAYER 7: DATABASE ============ -->
        <mxCell id="L7-label" value="LAYER 7 — Persistence" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1345" width="400" height="15" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="&lt;b&gt;MySQL&lt;/b&gt;&lt;br/&gt;Database:  cotsu-spms&lt;br/&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;(PDO · prepared statements)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1a5490;strokeColor=#0e2238;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="1365" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Audit cross-cut callout -->
        <mxCell id="audit-callout" value="&lt;b&gt;★ Cross-cutting concern&lt;/b&gt;&lt;br/&gt;All write operations across every role module&lt;br/&gt;invoke &lt;b&gt;writeAuditLog()&lt;/b&gt;  →  AuditLog model  →  audit tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;dashed=1;fontSize=10;verticalAlign=middle;align=center;fontColor=#7a1f15;" vertex="1" parent="1">
          <mxGeometry x="1232" y="1365" width="588" height="80" as="geometry" />
        </mxCell>

        <!-- ============ RIGHT SIDE PANELS ============ -->

        <!-- External Services -->
        <mxCell id="ext-label" value="EXTERNAL SERVICES (boundary)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1850" y="40" width="400" height="15" as="geometry" />
        </mxCell>
        <mxCell id="ext-smtp" value="&lt;b&gt;Gmail SMTP&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Host:  smtp.gmail.com:587&lt;br/&gt;Encryption:  STARTTLS&lt;br/&gt;Sender:  cotsulive@gmail.com&lt;br/&gt;Used by:  core/mailer.php&lt;br/&gt;Purpose:  password reset emails&lt;br/&gt;            (30-min expiring link)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1850" y="60" width="610" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ext-fs" value="&lt;b&gt;File System (Server)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;excelfiles/  — generated Excel exports&lt;br/&gt;Generated PDFs:  RPCI · RPCPPE · IIRUP · ICS · PAR · RIS&lt;br/&gt;PHP session storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1850" y="240" width="610" height="110" as="geometry" />
